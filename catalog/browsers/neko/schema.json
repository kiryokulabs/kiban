{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "KIBAN_NEKO_PORT": {
      "type": "string",
      "default": "${KIBAN_NEKO_PORT:-8080}"
    },
    "KIBAN_NEKO_WEBRTC_PORT": {
      "type": "string",
      "default": "${KIBAN_NEKO_WEBRTC_PORT:-52000}"
    },
    "KIBAN_NEKO_USER_PASSWORD": {
      "type": "string",
      "default": "${KIBAN_NEKO_USER_PASSWORD:-neko-user-password}"
    },
    "KIBAN_NEKO_ADMIN_PASSWORD": {
      "type": "string",
      "default": "${KIBAN_NEKO_ADMIN_PASSWORD:-neko-admin-password}"
    },
    "KIBAN_NEKO_NAT1TO1": {
      "type": "string",
      "default": "${KIBAN_NEKO_NAT1TO1:-127.0.0.1}"
    },
    "KIBAN_NEKO_SCREEN": {
      "type": "string",
      "default": "${KIBAN_NEKO_SCREEN:-1280x720@30}"
    }
  }
}
