{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "AUTHENTIK_BOOTSTRAP_EMAIL": {
      "type": "string",
      "title": "Authentik Bootstrap Email",
      "default": "admin@kiban.local"
    },
    "AUTHENTIK_BOOTSTRAP_PASSWORD": {
      "type": "string",
      "title": "Authentik Bootstrap Password",
      "default": "kiban",
      "x-kiban-secret": true
    },
    "AUTHENTIK_EMAIL__FROM": {
      "type": "string",
      "title": "Authentik Email From",
      "default": "admin@kiban.local"
    },
    "AUTHENTIK_EMAIL__HOST": {
      "type": "string",
      "title": "Authentik Email Host",
      "default": "admin@kiban.local"
    },
    "AUTHENTIK_EMAIL__PASSWORD": {
      "type": "string",
      "title": "Authentik Email Password",
      "default": "admin@kiban.local",
      "x-kiban-secret": true
    },
    "AUTHENTIK_EMAIL__PORT": {
      "type": "string",
      "title": "Authentik Email Port",
      "default": "admin@kiban.local"
    },
    "AUTHENTIK_EMAIL__TIMEOUT": {
      "type": "string",
      "title": "Authentik Email Timeout",
      "default": "admin@kiban.local"
    },
    "AUTHENTIK_EMAIL__USE_SSL": {
      "type": "string",
      "title": "Authentik Email Use Ssl",
      "default": "admin@kiban.local"
    },
    "AUTHENTIK_EMAIL__USE_TLS": {
      "type": "string",
      "title": "Authentik Email Use Tls",
      "default": "admin@kiban.local"
    },
    "AUTHENTIK_EMAIL__USERNAME": {
      "type": "string",
      "title": "Authentik Email Username",
      "default": "admin@kiban.local"
    },
    "POSTGRES_DB": {
      "type": "string",
      "title": "Postgres Db",
      "default": "authentik"
    },
    "POSTGRES_HOST": {
      "type": "string",
      "title": "Postgres Host",
      "default": "postgresql"
    },
    "SERVICE_PASSWORD_64_AUTHENTIKSERVER": {
      "type": "string",
      "title": "Service Password 64 Authentikserver",
      "default": "kiban-kiban-kiban-kiban-kiban-kiban-kiban-kiban",
      "x-kiban-secret": true
    },
    "SERVICE_PASSWORD_POSTGRESQL": {
      "type": "string",
      "title": "Service Password Postgresql",
      "default": "kiban",
      "x-kiban-secret": true
    },
    "SERVICE_USER_POSTGRESQL": {
      "type": "string",
      "title": "Service User Postgresql",
      "default": "admin"
    }
  }
}
