{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "KIBAN_ZABBIX_PORT": {
      "type": "string",
      "default": "${KIBAN_ZABBIX_PORT:-8080}"
    },
    "KIBAN_ZABBIX_SERVER_PORT": {
      "type": "string",
      "default": "${KIBAN_ZABBIX_SERVER_PORT:-10051}"
    },
    "KIBAN_ZABBIX_DB_PASSWORD": {
      "type": "string",
      "default": "${KIBAN_ZABBIX_DB_PASSWORD:-zabbix-password}"
    }
  }
}
