{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "POSTGRES_DB": {
      "type": "string",
      "title": "Postgres Db",
      "default": "windmill-db"
    },
    "SERVICE_PASSWORD_POSTGRES": {
      "type": "string",
      "title": "Service Password Postgres",
      "default": "kiban",
      "x-kiban-secret": true
    },
    "SERVICE_USER_POSTGRES": {
      "type": "string",
      "title": "Service User Postgres",
      "default": "admin"
    }
  }
}
