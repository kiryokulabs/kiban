{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "KIBAN_MAUTIC_PORT": {
      "type": "string",
      "default": "${KIBAN_MAUTIC_PORT:-80}"
    },
    "KIBAN_MAUTIC_DB_PASSWORD": {
      "type": "string",
      "default": "${KIBAN_MAUTIC_DB_PASSWORD:-mautic}"
    },
    "KIBAN_MAUTIC_DB_ROOT_PASSWORD": {
      "type": "string",
      "default": "${KIBAN_MAUTIC_DB_ROOT_PASSWORD:-root}"
    }
  }
}
