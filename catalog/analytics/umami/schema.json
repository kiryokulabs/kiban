{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "DATABASE_TYPE": {
      "type": "string",
      "title": "Database Type",
      "default": "postgres"
    },
    "POSTGRES_DB": {
      "type": "string",
      "title": "Postgres Db",
      "default": "umami"
    },
    "SERVICE_PASSWORD_64_UMAMI": {
      "type": "string",
      "title": "Service Password 64 Umami",
      "default": "kiban-kiban-kiban-kiban-kiban-kiban-kiban-kiban",
      "x-kiban-secret": true
    },
    "SERVICE_PASSWORD_POSTGRES": {
      "type": "string",
      "title": "Service Password Postgres",
      "default": "kiban",
      "x-kiban-secret": true
    },
    "SERVICE_USER_POSTGRES": {
      "type": "string",
      "title": "Service User Postgres",
      "default": "admin"
    }
  }
}
