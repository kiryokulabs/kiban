{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "MATOMO_DB_NAME": {
      "type": "string",
      "title": "Database name",
      "default": "${MATOMO_DB_NAME:-matomo}"
    },
    "MATOMO_DB_USER": {
      "type": "string",
      "title": "Database username",
      "default": "${MATOMO_DB_USER:-matomo}"
    },
    "MATOMO_DB_PASSWORD": {
      "type": "string",
      "title": "Database password",
      "default": "${MATOMO_DB_PASSWORD:-kiban}"
    },
    "MATOMO_ROOT_PASSWORD": {
      "type": "string",
      "title": "Database root password",
      "default": "${MATOMO_ROOT_PASSWORD:-kiban}"
    },
    "MATOMO_TABLES_PREFIX": {
      "type": "string",
      "title": "Database tables prefix",
      "default": "${MATOMO_TABLES_PREFIX:-matomo_}"
    }
  }
}
