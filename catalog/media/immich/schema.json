{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "DB_DATABASE_NAME": {
      "type": "string",
      "title": "Db Database Name",
      "default": "immich"
    },
    "POSTGRES_INITDB_ARGS": {
      "type": "string",
      "title": "Postgres Initdb Args",
      "default": "--data-checksums"
    },
    "SERVICE_PASSWORD_POSTGRES": {
      "type": "string",
      "title": "Service Password Postgres",
      "default": "kiban",
      "x-kiban-secret": true
    },
    "SERVICE_USER_POSTGRES": {
      "type": "string",
      "title": "Service User Postgres",
      "default": "admin"
    }
  }
}
