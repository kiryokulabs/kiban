{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "KIBAN_IMMICH_DB_USER": {
      "type": "string",
      "default": "${KIBAN_IMMICH_DB_USER:-postgres}"
    },
    "KIBAN_IMMICH_DB_PASSWORD": {
      "type": "string",
      "default": "${KIBAN_IMMICH_DB_PASSWORD:-immich}"
    },
    "KIBAN_IMMICH_DB_NAME": {
      "type": "string",
      "default": "${KIBAN_IMMICH_DB_NAME:-immich}"
    }
  }
}
