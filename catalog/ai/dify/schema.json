{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "KIBAN_DIFY_SECRET_KEY": {
      "type": "string",
      "default": "${KIBAN_DIFY_SECRET_KEY:-sk-change-me-to-a-random-string-of-32-chars}"
    },
    "KIBAN_DIFY_DB_USER": {
      "type": "string",
      "default": "${KIBAN_DIFY_DB_USER:-postgres}"
    },
    "KIBAN_DIFY_DB_PASSWORD": {
      "type": "string",
      "default": "${KIBAN_DIFY_DB_PASSWORD:-dify}"
    },
    "KIBAN_DIFY_DB_NAME": {
      "type": "string",
      "default": "${KIBAN_DIFY_DB_NAME:-dify}"
    },
    "KIBAN_DIFY_REDIS_PASSWORD": {
      "type": "string",
      "default": "${KIBAN_DIFY_REDIS_PASSWORD:-dify}"
    }
  }
}
