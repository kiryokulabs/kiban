{
  "id": "open-webui",
  "name": "Open WebUI",
  "description": "Official Open WebUI interface for local AI workflows.",
  "version": "1.0.0",
  "author": "Kiban",
  "category": "ai",
  "icon": "icon.svg",
  "docker": {
    "image": "ghcr.io/open-webui/open-webui",
    "tag": "main"
  },
  "ports": [
    {
      "name": "default",
      "port": 8080,
      "protocol": "tcp",
      "public": true
    }
  ],
  "volumes": [
    {
      "name": "data",
      "mountPath": "/data",
      "persistent": true
    }
  ],
  "environment": [
    {
      "key": "OLLAMA_BASE_URL",
      "required": false,
      "defaultValue": "${KIBAN_OPENWEBUI_OLLAMA_BASE_URL:-http://host.docker.internal:11434}"
    }
  ],
  "minimumVersion": "0.1.0"
}
