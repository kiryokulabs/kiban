{
  "id": "langflow",
  "name": "Langflow",
  "description": "Official Langflow visual AI application builder.",
  "version": "1.0.0",
  "author": "Kiban",
  "category": "ai",
  "icon": "icon.svg",
  "docker": {
    "image": "langflowai/langflow",
    "tag": "latest"
  },
  "ports": [
    {
      "name": "default",
      "port": 7860,
      "protocol": "tcp",
      "public": true
    }
  ],
  "volumes": [
    {
      "name": "data",
      "mountPath": "/data",
      "persistent": true
    }
  ],
  "environment": [],
  "minimumVersion": "0.1.0"
}
