{
  "id": "flowise",
  "name": "Flowise",
  "description": "Official Flowise low-code AI workflow builder.",
  "version": "1.0.0",
  "author": "Kiban",
  "category": "ai",
  "icon": "icon.svg",
  "docker": {
    "image": "flowiseai/flowise",
    "tag": "latest"
  },
  "ports": [
    {
      "name": "default",
      "port": 3000,
      "protocol": "tcp",
      "public": true
    }
  ],
  "volumes": [
    {
      "name": "data",
      "mountPath": "/data",
      "persistent": true
    }
  ],
  "environment": [
    {
      "key": "PORT",
      "required": false,
      "defaultValue": "3000"
    }
  ],
  "minimumVersion": "0.1.0"
}
