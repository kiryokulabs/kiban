{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "KIBAN_RALLY_PORT": {
      "type": "string",
      "default": "${KIBAN_RALLY_PORT:-3000}"
    },
    "KIBAN_RALLY_SECRET_PASSWORD": {
      "type": "string",
      "default": "${KIBAN_RALLY_SECRET_PASSWORD:-rallly-secret-password-change-me-000000000000}"
    },
    "KIBAN_RALLY_SUPPORT_EMAIL": {
      "type": "string",
      "default": "${KIBAN_RALLY_SUPPORT_EMAIL:-admin@example.com}"
    },
    "KIBAN_RALLY_NOREPLY_EMAIL": {
      "type": "string",
      "default": "${KIBAN_RALLY_NOREPLY_EMAIL:-admin@example.com}"
    },
    "KIBAN_RALLY_SMTP_HOST": {
      "type": "string",
      "default": "${KIBAN_RALLY_SMTP_HOST:-localhost}"
    },
    "KIBAN_RALLY_SMTP_PORT": {
      "type": "string",
      "default": "${KIBAN_RALLY_SMTP_PORT:-25}"
    },
    "KIBAN_RALLY_SMTP_USER": {
      "type": "string",
      "default": "${KIBAN_RALLY_SMTP_USER:-}"
    },
    "KIBAN_RALLY_SMTP_PASSWORD": {
      "type": "string",
      "default": "${KIBAN_RALLY_SMTP_PASSWORD:-}"
    },
    "KIBAN_RALLY_DB_PASSWORD": {
      "type": "string",
      "default": "${KIBAN_RALLY_DB_PASSWORD:-rallly-postgres-password}"
    },
    "KIBAN_RALLY_S3_ACCESS_KEY": {
      "type": "string",
      "default": "${KIBAN_RALLY_S3_ACCESS_KEY:-rallly-access-key}"
    },
    "KIBAN_RALLY_S3_SECRET_KEY": {
      "type": "string",
      "default": "${KIBAN_RALLY_S3_SECRET_KEY:-rallly-secret-key}"
    },
    "KIBAN_RALLY_INITIAL_ADMIN_EMAIL": {
      "type": "string",
      "default": "${KIBAN_RALLY_INITIAL_ADMIN_EMAIL:-admin@example.com}"
    }
  }
}
