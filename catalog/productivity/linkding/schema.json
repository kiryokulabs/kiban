{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "KIBAN_LINKDING_PORT": {
      "type": "string",
      "default": "${KIBAN_LINKDING_PORT:-9090}"
    },
    "KIBAN_LINKDING_SUPERUSER_NAME": {
      "type": "string",
      "default": "${KIBAN_LINKDING_SUPERUSER_NAME:-admin}"
    },
    "KIBAN_LINKDING_SUPERUSER_PASSWORD": {
      "type": "string",
      "default": "${KIBAN_LINKDING_SUPERUSER_PASSWORD:-linkding-admin-password}"
    }
  }
}
