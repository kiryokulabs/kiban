{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "BB_ADMIN_USER_EMAIL": {
      "type": "string",
      "title": "Bb Admin User Email",
      "default": "admin@kiban.local"
    },
    "BB_ADMIN_USER_PASSWORD": {
      "type": "string",
      "title": "Bb Admin User Password",
      "default": "admin",
      "x-kiban-secret": true
    },
    "REDIS_URL": {
      "type": "string",
      "title": "Redis Url",
      "default": "redis-service:6379"
    },
    "SERVICE_BASE64_128_BUDIBASE": {
      "type": "string",
      "title": "Service Base64 128 Budibase",
      "default": "kiban"
    },
    "SERVICE_BASE64_64_BUDIBASE": {
      "type": "string",
      "title": "Service Base64 64 Budibase",
      "default": "kiban"
    },
    "SERVICE_BASE64_64_BUDIBASEAPI": {
      "type": "string",
      "title": "Service Base64 64 Budibaseapi",
      "default": "kiban"
    },
    "SERVICE_BASE64_64_BUDIBASEJWT": {
      "type": "string",
      "title": "Service Base64 64 Budibasejwt",
      "default": "kiban"
    },
    "SERVICE_PASSWORD_COUCHDB": {
      "type": "string",
      "title": "Service Password Couchdb",
      "default": "kiban",
      "x-kiban-secret": true
    },
    "SERVICE_PASSWORD_MINIO": {
      "type": "string",
      "title": "Service Password Minio",
      "default": "kiban",
      "x-kiban-secret": true
    },
    "SERVICE_PASSWORD_REDIS": {
      "type": "string",
      "title": "Service Password Redis",
      "default": "kiban",
      "x-kiban-secret": true
    },
    "SERVICE_PASSWORD_WATCHTOWER": {
      "type": "string",
      "title": "Service Password Watchtower",
      "default": "kiban",
      "x-kiban-secret": true
    },
    "SERVICE_USER_COUCHDB": {
      "type": "string",
      "title": "Service User Couchdb",
      "default": "admin"
    },
    "SERVICE_USER_MINIO": {
      "type": "string",
      "title": "Service User Minio",
      "default": "admin"
    }
  }
}
