{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "KIBAN_SIMPLEX_CHAT_PORT": {
      "type": "string",
      "default": "${KIBAN_SIMPLEX_CHAT_PORT:-5223}"
    },
    "KIBAN_SIMPLEX_CHAT_ADDR": {
      "type": "string",
      "default": "${KIBAN_SIMPLEX_CHAT_ADDR:-smp1.example.org}"
    },
    "KIBAN_SIMPLEX_CHAT_PASSWORD": {
      "type": "string",
      "default": "${KIBAN_SIMPLEX_CHAT_PASSWORD:-}"
    },
    "KIBAN_SIMPLEX_CHAT_WEB_MANUAL": {
      "type": "string",
      "default": "${KIBAN_SIMPLEX_CHAT_WEB_MANUAL:-1}"
    }
  }
}
