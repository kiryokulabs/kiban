{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "MARIADB_DATABASE": {
      "type": "string",
      "default": "${MARIADB_DATABASE:-kiban}"
    },
    "MARIADB_USER": {
      "type": "string",
      "default": "${MARIADB_USER:-kiban}"
    },
    "MARIADB_PASSWORD": {
      "type": "string",
      "default": "${MARIADB_PASSWORD:-kiban}"
    },
    "MARIADB_ROOT_PASSWORD": {
      "type": "string",
      "default": "${MARIADB_ROOT_PASSWORD:-kiban}"
    }
  }
}
