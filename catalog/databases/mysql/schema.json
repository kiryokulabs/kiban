{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "MYSQL_DATABASE": {
      "type": "string",
      "default": "${MYSQL_DATABASE:-kiban}"
    },
    "MYSQL_USER": {
      "type": "string",
      "default": "${MYSQL_USER:-kiban}"
    },
    "MYSQL_PASSWORD": {
      "type": "string",
      "default": "${MYSQL_PASSWORD:-kiban}"
    },
    "MYSQL_ROOT_PASSWORD": {
      "type": "string",
      "default": "${MYSQL_ROOT_PASSWORD:-kiban}"
    }
  }
}
