{
  "id": "adminer",
  "name": "Adminer",
  "description": "Official Adminer database administration UI.",
  "version": "1.0.0",
  "author": "Kiban",
  "category": "development",
  "icon": "icon.svg",
  "docker": {
    "image": "adminer",
    "tag": "latest"
  },
  "ports": [
    {
      "name": "default",
      "port": 8080,
      "protocol": "tcp",
      "public": true
    }
  ],
  "volumes": [
    {
      "name": "data",
      "mountPath": "/data",
      "persistent": true
    }
  ],
  "environment": [],
  "minimumVersion": "0.1.0"
}
