{
  "id": "mongo-express",
  "name": "Mongo Express",
  "description": "Official Mongo Express administration UI.",
  "version": "1.0.0",
  "author": "Kiban",
  "category": "development",
  "icon": "icon.svg",
  "docker": {
    "image": "mongo-express",
    "tag": "latest"
  },
  "ports": [
    {
      "name": "default",
      "port": 8081,
      "protocol": "tcp",
      "public": true
    }
  ],
  "volumes": [
    {
      "name": "data",
      "mountPath": "/data",
      "persistent": true
    }
  ],
  "environment": [
    {
      "key": "ME_CONFIG_MONGODB_ADMINUSERNAME",
      "required": false,
      "defaultValue": "${KIBAN_MONGOEXPRESS_USERNAME:-admin}"
    },
    {
      "key": "ME_CONFIG_MONGODB_ADMINPASSWORD",
      "required": false,
      "defaultValue": "${KIBAN_MONGOEXPRESS_PASSWORD:-kiban}"
    },
    {
      "key": "ME_CONFIG_MONGODB_URL",
      "required": false,
      "defaultValue": "${KIBAN_MONGOEXPRESS_MONGODB_URL:-mongodb://admin:kiban@mongo:27017/}"
    }
  ],
  "minimumVersion": "0.1.0"
}
