{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "ME_CONFIG_MONGODB_ADMINUSERNAME": {
      "type": "string",
      "default": "${KIBAN_MONGOEXPRESS_USERNAME:-admin}"
    },
    "ME_CONFIG_MONGODB_ADMINPASSWORD": {
      "type": "string",
      "default": "${KIBAN_MONGOEXPRESS_PASSWORD:-kiban}"
    },
    "ME_CONFIG_MONGODB_URL": {
      "type": "string",
      "default": "${KIBAN_MONGOEXPRESS_MONGODB_URL:-mongodb://admin:kiban@mongo:27017/}"
    }
  }
}
