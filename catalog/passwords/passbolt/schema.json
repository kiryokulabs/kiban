{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "KIBAN_PASSBOLT_DB_NAME": {
      "type": "string",
      "default": "${KIBAN_PASSBOLT_DB_NAME:-passbolt}"
    },
    "KIBAN_PASSBOLT_DB_USER": {
      "type": "string",
      "default": "${KIBAN_PASSBOLT_DB_USER:-passbolt}"
    },
    "KIBAN_PASSBOLT_DB_PASSWORD": {
      "type": "string",
      "default": "${KIBAN_PASSBOLT_DB_PASSWORD:-passbolt}"
    },
    "KIBAN_PASSBOLT_DB_ROOT_PASSWORD": {
      "type": "string",
      "default": "${KIBAN_PASSBOLT_DB_ROOT_PASSWORD:-root}"
    }
  }
}
