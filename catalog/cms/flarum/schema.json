{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "KIBAN_FLARUM_PORT": {
      "type": "string",
      "default": "${KIBAN_FLARUM_PORT:-8000}"
    },
    "KIBAN_FLARUM_DB_PASSWORD": {
      "type": "string",
      "default": "${KIBAN_FLARUM_DB_PASSWORD:-flarum-password}"
    },
    "KIBAN_FLARUM_DB_ROOT_PASSWORD": {
      "type": "string",
      "default": "${KIBAN_FLARUM_DB_ROOT_PASSWORD:-flarum-root-password}"
    }
  }
}
