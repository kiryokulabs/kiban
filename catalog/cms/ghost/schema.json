{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "database__client": {
      "type": "string",
      "title": "Database Client",
      "default": "mysql"
    },
    "database__connection__database": {
      "type": "string",
      "title": "Database Connection Database",
      "default": "ghost"
    },
    "database__connection__host": {
      "type": "string",
      "title": "Database Connection Host",
      "default": "mysql"
    },
    "MAIL_OPTIONS_AUTH_USER": {
      "type": "string",
      "title": "Mail Options Auth User",
      "default": "admin"
    },
    "MYSQL_DATABASE": {
      "type": "string",
      "title": "Mysql Database",
      "default": "kiban"
    },
    "SERVICE_PASSWORD_MYSQL": {
      "type": "string",
      "title": "Service Password Mysql",
      "default": "kiban",
      "x-kiban-secret": true
    },
    "SERVICE_PASSWORD_MYSQLROOT": {
      "type": "string",
      "title": "Service Password Mysqlroot",
      "default": "kiban",
      "x-kiban-secret": true
    },
    "SERVICE_USER_MYSQL": {
      "type": "string",
      "title": "Service User Mysql",
      "default": "admin"
    }
  }
}
