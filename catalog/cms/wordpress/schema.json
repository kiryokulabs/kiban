{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "KIBAN_WORDPRESS_DB_NAME": {
      "type": "string",
      "default": "${KIBAN_WORDPRESS_DB_NAME:-wordpress}"
    },
    "KIBAN_WORDPRESS_DB_USER": {
      "type": "string",
      "default": "${KIBAN_WORDPRESS_DB_USER:-wordpress}"
    },
    "KIBAN_WORDPRESS_DB_PASSWORD": {
      "type": "string",
      "default": "${KIBAN_WORDPRESS_DB_PASSWORD:-wordpress}"
    },
    "KIBAN_WORDPRESS_DB_ROOT_PASSWORD": {
      "type": "string",
      "default": "${KIBAN_WORDPRESS_DB_ROOT_PASSWORD:-root}"
    }
  }
}
