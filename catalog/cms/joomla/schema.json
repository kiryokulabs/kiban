{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "KIBAN_JOOMLA_DB_NAME": {
      "type": "string",
      "default": "${KIBAN_JOOMLA_DB_NAME:-joomla}"
    },
    "KIBAN_JOOMLA_DB_USER": {
      "type": "string",
      "default": "${KIBAN_JOOMLA_DB_USER:-joomla}"
    },
    "KIBAN_JOOMLA_DB_PASSWORD": {
      "type": "string",
      "default": "${KIBAN_JOOMLA_DB_PASSWORD:-joomla}"
    },
    "KIBAN_JOOMLA_DB_ROOT_PASSWORD": {
      "type": "string",
      "default": "${KIBAN_JOOMLA_DB_ROOT_PASSWORD:-root}"
    }
  }
}
