#!/usr/bin/env sh
# Kiban CLI — POSIX shell interface for local Kiban management.
# Requires: Docker, Docker Compose v2. No other dependencies.
set -eu

installed_home() {
  script_path="$0"

  case "${script_path}" in
    */*) ;;
    *) script_path="$(command -v "${script_path}" 2>/dev/null || printf '%s' "${script_path}")" ;;
  esac

  script_dir="$(cd -P "$(dirname "${script_path}")" >/dev/null 2>&1 && pwd || printf '%s' "${HOME}/.kiban/bin")"
  case "${script_dir}" in
    */bin) dirname "${script_dir}" ;;
    *) printf '%s' "${HOME}/.kiban" ;;
  esac
}

KIBAN_HOME="${KIBAN_HOME:-$(installed_home)}"
KIBAN_RELEASE_CHANNEL="${KIBAN_RELEASE_CHANNEL:-latest}"
KIBAN_RELEASE_BASE="${KIBAN_RELEASE_BASE:-https://get.kibanos.com/${KIBAN_RELEASE_CHANNEL}}"
KIBAN_VERSION_URL="${KIBAN_VERSION_URL:-${KIBAN_RELEASE_BASE}/VERSION}"
KIBAN_COMPOSE_URL="${KIBAN_COMPOSE_URL:-${KIBAN_RELEASE_BASE}/compose.yaml}"
KIBAN_CLI_URL="${KIBAN_CLI_URL:-${KIBAN_RELEASE_BASE}/kiban}"
KIBAN_RUNTIME_DIR="${KIBAN_HOME}/runtime/kiban"
KIBAN_COMPOSE_FILE="${KIBAN_RUNTIME_DIR}/compose.yaml"
KIBAN_ENV_FILE="${KIBAN_RUNTIME_DIR}/.env"
KIBAN_SERVICES_DIR="${KIBAN_HOME}/runtime/services"
KIBAN_TRAEFIK_DIR="${KIBAN_HOME}/runtime/traefik"
KIBAN_BIN_FILE="${KIBAN_HOME}/bin/kiban"

info()  { printf '%s\n' "[kiban] $*"; }
fail()  { printf '%s\n' "[kiban] Error: $*" >&2; exit 1; }
warn()  { printf '%s\n' "[kiban] Warning: $*"; }

command_exists() { command -v "$1" >/dev/null 2>&1; }

# ---------------------------------------------------------------------------
# version
# ---------------------------------------------------------------------------
cmd_version() {
  if [ -r "${KIBAN_ENV_FILE}" ]; then
    version="$(grep '^KIBAN_VERSION=' "${KIBAN_ENV_FILE}" | head -1 | cut -d= -f2- || true)"
    if [ -n "${version}" ]; then
      printf 'kiban %s\n' "${version}"
      return 0
    fi
  fi
  printf 'kiban (version unknown)\n'
}

# ---------------------------------------------------------------------------
# doctor
# ---------------------------------------------------------------------------
cmd_doctor() {
  errors=0

  # Docker
  if command_exists docker; then
    info "✓ Docker installed"
  else
    warn "✗ Docker not found"
    errors=$((errors + 1))
  fi

  # Docker daemon
  if docker info >/dev/null 2>&1; then
    info "✓ Docker is running"
  else
    warn "✗ Docker is not running"
    errors=$((errors + 1))
  fi

  # Docker Compose v2
  if docker compose version >/dev/null 2>&1; then
    info "✓ Docker Compose v2 available"
  else
    warn "✗ Docker Compose v2 not available"
    errors=$((errors + 1))
  fi

  # Kiban home directory
  if [ -d "${KIBAN_HOME}" ]; then
    info "✓ Kiban directory exists (${KIBAN_HOME})"
  else
    warn "✗ Kiban directory not found (${KIBAN_HOME})"
    errors=$((errors + 1))
  fi

  # Kiban runtime
  if [ -r "${KIBAN_COMPOSE_FILE}" ] && [ -r "${KIBAN_ENV_FILE}" ]; then
    info "✓ Kiban runtime found"
  else
    warn "✗ Kiban runtime not found (${KIBAN_RUNTIME_DIR})"
    errors=$((errors + 1))
  fi

  if [ "${errors}" -gt 0 ]; then
    fail "${errors} check(s) failed. Run the installer to fix: curl -fsSL https://get.kibanos.com | sh"
  fi

  info "All checks passed."
}

# ---------------------------------------------------------------------------
# status
# ---------------------------------------------------------------------------
cmd_status() {
  ensure_runtime

  info "Kiban core runtime:"
  docker compose --env-file "${KIBAN_ENV_FILE}" -f "${KIBAN_COMPOSE_FILE}" ps --format "table {{.Name}}\t{{.Status}}"

  # Installed services
  if [ -d "${KIBAN_SERVICES_DIR}" ]; then
    count=0
    for dir in "${KIBAN_SERVICES_DIR}"/*/; do
      [ -d "${dir}" ] || continue
      count=$((count + 1))
    done

    if [ "${count}" -gt 0 ]; then
      printf '\n'
      info "Installed services: ${count}"
      for dir in "${KIBAN_SERVICES_DIR}"/*/; do
        [ -d "${dir}" ] || continue
        svc_env="${dir}.env"
        svc_compose="${dir}compose.yaml"
        if [ -r "${svc_env}" ] && [ -r "${svc_compose}" ]; then
          svc_name="$(basename "${dir}")"
          status="$(docker compose --env-file "${svc_env}" -f "${svc_compose}" ps --format "{{.Status}}" 2>/dev/null | head -1)"
          if [ -z "${status}" ]; then
            status="unknown"
          fi
          info "  ${svc_name}: ${status}"
        fi
      done
    fi
  fi
}

# ---------------------------------------------------------------------------
# start
# ---------------------------------------------------------------------------
cmd_start() {
  ensure_runtime
  info "Starting Kiban..."
  docker compose --env-file "${KIBAN_ENV_FILE}" -f "${KIBAN_COMPOSE_FILE}" up -d
  http_port="$(env_value KIBAN_HTTP_PORT 8080)"
  info "Kiban is running at http://localhost:${http_port}"
}

# ---------------------------------------------------------------------------
# stop
# ---------------------------------------------------------------------------
cmd_stop() {
  ensure_runtime
  info "Stopping Kiban..."
  docker compose --env-file "${KIBAN_ENV_FILE}" -f "${KIBAN_COMPOSE_FILE}" down
  info "Kiban stopped."
}

# ---------------------------------------------------------------------------
# restart
# ---------------------------------------------------------------------------
cmd_restart() {
  ensure_runtime
  info "Restarting Kiban..."
  docker compose --env-file "${KIBAN_ENV_FILE}" -f "${KIBAN_COMPOSE_FILE}" restart
  info "Kiban restarted."
}

# ---------------------------------------------------------------------------
# logs
# ---------------------------------------------------------------------------
cmd_logs() {
  ensure_runtime

  tail_lines=300
  while [ $# -gt 0 ]; do
    case "$1" in
      --tail)
        shift
        [ $# -gt 0 ] || fail "--tail requires a number"
        tail_lines="$1"
        ;;
      --tail=*)
        tail_lines="${1#--tail=}"
        ;;
      *)
        fail "Unknown option: $1"
        ;;
    esac
    shift
  done

  docker compose --env-file "${KIBAN_ENV_FILE}" -f "${KIBAN_COMPOSE_FILE}" logs --tail="${tail_lines}" kiban-api kiban-web
}

# ---------------------------------------------------------------------------
# update
# ---------------------------------------------------------------------------
cmd_update() {
  ensure_runtime
  ensure_curl

  assume_yes=0
  while [ $# -gt 0 ]; do
    case "$1" in
      -y|--yes)
        assume_yes=1
        ;;
      *)
        fail "Unknown option: $1"
        ;;
    esac
    shift
  done

  current_version="$(env_value KIBAN_VERSION unknown)"
  latest_version="$(curl -fsSL "${KIBAN_VERSION_URL}" | tr -d '\r\n' | sed 's/^v//')"
  [ -n "${latest_version}" ] || fail "Could not resolve latest Kiban version from ${KIBAN_VERSION_URL}."

  if [ "${current_version}" = "${latest_version}" ]; then
    info "Kiban is already up to date (${current_version})."
    return 0
  fi

  if [ "${assume_yes}" -ne 1 ]; then
    warn "This updates Kiban from ${current_version} to ${latest_version}."
    warn "Installed services will not be removed."
    printf '%s' "Continue? [y/N] "
    read answer || answer=""
    case "${answer}" in
      y|Y|yes|YES) ;;
      *) info "Update cancelled."; return 0 ;;
    esac
  fi

  compose_next="${KIBAN_COMPOSE_FILE}.next"
  cli_next="${KIBAN_BIN_FILE}.next"
  env_next="${KIBAN_ENV_FILE}.next"

  info "Downloading Kiban ${latest_version}..."
  curl -fsSL "${KIBAN_COMPOSE_URL}" -o "${compose_next}"
  curl -fsSL "${KIBAN_CLI_URL}" -o "${cli_next}"
  chmod +x "${cli_next}"

  set_env_value KIBAN_VERSION "${latest_version}" "${env_next}"

  mv "${compose_next}" "${KIBAN_COMPOSE_FILE}"
  mv "${cli_next}" "${KIBAN_BIN_FILE}"
  mv "${env_next}" "${KIBAN_ENV_FILE}"
  chmod 600 "${KIBAN_ENV_FILE}"

  info "Pulling Kiban ${latest_version}..."
  docker compose --env-file "${KIBAN_ENV_FILE}" -f "${KIBAN_COMPOSE_FILE}" pull

  info "Restarting Kiban..."
  docker compose --env-file "${KIBAN_ENV_FILE}" -f "${KIBAN_COMPOSE_FILE}" up -d

  info "Kiban updated to ${latest_version}."
  info "Installed services were not removed."
}

# ---------------------------------------------------------------------------
# uninstall
# ---------------------------------------------------------------------------
cmd_uninstall() {
  assume_yes=0

  while [ $# -gt 0 ]; do
    case "$1" in
      -y|--yes)
        assume_yes=1
        ;;
      *)
        fail "Unknown option: $1"
        ;;
    esac
    shift
  done

  if [ "${assume_yes}" -ne 1 ]; then
    warn "This removes Kiban itself, but leaves installed services untouched."
    warn "Kiban data under ${KIBAN_HOME} is preserved so services are not removed."
    printf '%s' "Continue? [y/N] "
    read answer || answer=""
    case "${answer}" in
      y|Y|yes|YES) ;;
      *) info "Uninstall cancelled."; return 0 ;;
    esac
  fi

  info "Uninstalling Kiban..."

  if [ -r "${KIBAN_COMPOSE_FILE}" ] && [ -r "${KIBAN_ENV_FILE}" ]; then
    info "Stopping Kiban..."
    docker compose --env-file "${KIBAN_ENV_FILE}" -f "${KIBAN_COMPOSE_FILE}" down
  else
    warn "Kiban runtime not found. Skipping Kiban stop."
  fi

  if [ -r "${KIBAN_TRAEFIK_DIR}/compose.yaml" ]; then
    info "Stopping Kiban routing layer..."
    (cd "${KIBAN_TRAEFIK_DIR}" && docker compose --project-name kiban-traefik -f compose.yaml down)
  fi

  rm -rf -- "${KIBAN_RUNTIME_DIR}"
  rm -rf -- "${KIBAN_TRAEFIK_DIR}"

  if [ -f "${KIBAN_BIN_FILE}" ]; then
    rm -f -- "${KIBAN_BIN_FILE}"
  fi

  info "Kiban uninstalled."
  info "Installed services were not removed."
  info "Remove Kiban from your shell PATH if your profile still references ${KIBAN_HOME}/bin."
}

# ---------------------------------------------------------------------------
# helpers
# ---------------------------------------------------------------------------
ensure_runtime() {
  if [ ! -r "${KIBAN_COMPOSE_FILE}" ] || [ ! -r "${KIBAN_ENV_FILE}" ]; then
    fail "Kiban is not installed. Run the installer: curl -fsSL https://get.kibanos.com | sh"
  fi
}

env_value() {
  key="$1"
  default="$2"

  if [ -r "${KIBAN_ENV_FILE}" ]; then
    value="$(grep "^${key}=" "${KIBAN_ENV_FILE}" | head -1 | cut -d= -f2- || true)"
    if [ -n "${value}" ]; then
      printf '%s' "${value}"
      return 0
    fi
  fi

  printf '%s' "${default}"
}

ensure_curl() {
  command_exists curl || fail "curl is required to update Kiban."
}

set_env_value() {
  key="$1"
  value="$2"
  destination="$3"
  found=0

  : > "${destination}"
  while IFS= read -r line || [ -n "${line}" ]; do
    case "${line}" in
      "${key}="*)
        printf '%s=%s\n' "${key}" "${value}" >> "${destination}"
        found=1
        ;;
      *)
        printf '%s\n' "${line}" >> "${destination}"
        ;;
    esac
  done < "${KIBAN_ENV_FILE}"

  if [ "${found}" -eq 0 ]; then
    printf '%s=%s\n' "${key}" "${value}" >> "${destination}"
  fi
}

# ---------------------------------------------------------------------------
# main
# ---------------------------------------------------------------------------
usage() {
  cat <<USAGE
Usage: kiban <command>

Commands:
  version       Show Kiban version
  doctor        Check installation prerequisites
  status        Show runtime and installed services status
  start         Start Kiban core runtime
  stop          Stop Kiban core runtime
  restart       Restart Kiban core runtime
  logs          Show Kiban core runtime logs (--tail N)
  update        Update Kiban without removing installed services
  uninstall     Uninstall Kiban without removing installed services

Usage:
  kiban version
  kiban doctor
  kiban status
  kiban start
  kiban stop
  kiban restart
  kiban logs
  kiban logs --tail 50
  kiban update
  kiban update --yes
  kiban uninstall
  kiban uninstall --yes
USAGE
}

main() {
  if [ $# -eq 0 ]; then
    usage
    exit 0
  fi

  cmd="$1"
  shift

  case "${cmd}" in
    version)  cmd_version ;;
    doctor)   cmd_doctor ;;
    status)   cmd_status ;;
    start)    cmd_start ;;
    stop)     cmd_stop ;;
    restart)  cmd_restart ;;
    logs)     cmd_logs "$@" ;;
    update) cmd_update "$@" ;;
    uninstall) cmd_uninstall "$@" ;;
    -h|--help|help) usage ;;
    *) fail "Unknown command: ${cmd}. Run 'kiban --help' for usage." ;;
  esac
}

main "$@"
