{
  "name": "@kiban/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "kiban": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput"
  },
  "dependencies": {
    "@kiban/shared": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^3.2.4",
    "typescript": "^5.7.2"
  }
}
